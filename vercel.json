{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd cyber && npm run build",
  "outputDirectory": "cyber/dist",
  "installCommand": "cd cyber && npm install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
